# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
.python-version

# Test, lint and type-check caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/

# Robo's runtime files (normally in ~/.config/robo, but keep them out if
# XDG_CONFIG_HOME ever points inside the repo)
settings.json
settings.json.tmp
*.lock
*.log

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS clutter
.DS_Store
Thumbs.db
